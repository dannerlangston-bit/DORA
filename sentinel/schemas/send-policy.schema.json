{
  "$id": "sentinel:schemas/send-policy.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "decision": {
      "enum": [
        "OPEN",
        "approved",
        "declined"
      ]
    },
    "enabled": {
      "default": false,
      "type": "boolean"
    },
    "risk_owner": {
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "signature": {
      "type": "string"
    },
    "signed_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "decision"
  ],
  "title": "send-policy (send_policy)",
  "type": "object"
}
