{
  "name": "dora",
  "version": "0.1.0",
  "description": "Build a map that explains a project, inside VS Code, with your AI filling it alongside you.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "bin": {
    "dora": "bin/dora.js"
  },
  "files": [
