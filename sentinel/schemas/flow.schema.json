    "preconditions": {
      "items": {
        "$ref": "#/$defs/step"
      },
      "type": "array"
    },
    "requires": {
      "items": {
        "enum": [
          "margin",
          "options_L1",
          "options_L2",
          "options_L3",
          "futures",
          "forex",
          "ira",
          "portfolio_margin",
          "multi_account",
          "paper_send"
        ]
      },
      "type": "array"
    },
    "requires_window": {
      "default": "none",
      "enum": [
        "none",
        "all_quiet",
        "equities_quiet",
        "futures_break"
      ]
    },
    "schema_version": {
      "const": 2,
      "type": "integer"
    },
    "state_scope": {
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "type": "string"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/step"
      },
      "type": "array"
    },
    "surface": {
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "type": "string"
    },
    "surfaces": {
      "items": {
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
        "type": "string"
      },
      "type": "array"
    },
    "teardown": {
      "items": {
        "$ref": "#/$defs/step"
      },
      "type": "array"
    },
    "tier": {
      "enum": [
        1,
        2,
        3
      ]
    },
    "title": {
      "type": "string"
    },
    "workspace": {
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "flow_id",
    "title",
    "class",
    "tier",
    "owner",
    "persona",
    "surface",
    "surfaces",
    "requires",
    "workspace",
    "fixture",
    "data_mode",
    "agent_fallback",
    "budget",
    "normalize",
    "preconditions",
    "steps",
    "teardown"
  ],
  "title": "flow (flow)",
  "type": "object"
}
