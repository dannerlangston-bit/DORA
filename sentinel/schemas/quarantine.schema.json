{
  "$defs": {
    "quarantine_record": {
      "additionalProperties": false,
      "properties": {
        "checkpoint": {
          "pattern": "^(?:census/[a-z0-9]+(?:[.-][a-z0-9]+)*/[a-z0-9]+(?:[.-][a-z0-9]+)*(?:/[a-z]+=[A-Za-z0-9.-]+(?:,[a-z]+=[A-Za-z0-9.-]+)*)?|sweep/[a-z0-9]+(?:[.-][a-z0-9]+)*/(?:flexgrid|detached|dialog)/[0-9]+x[0-9]+(?:-asc)?|split/[a-z0-9]+(?:[.-][a-z0-9]+)*/[a-z0-9]+(?:[.-][a-z0-9]+)*/(?:0|1)\\.[0-9]{2}|flow/[a-z0-9]+(?:[.-][a-z0-9]+)*/[a-z0-9]+(?:[.-][a-z0-9]+)*/[a-z][a-z0-9-]*)$",
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "entered": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "type": "string"
        },
        "flow": {
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "reason": {
          "enum": [
            "flake",
            "aa_drift",
            "aa_floor",
            "maintenance_budget",
            "fire_drill",
            "safety_canary",
            "kill_switch",
            "gateway_drops",
            "fallback_rate"
          ]
        },
        "ticket": {
          "type": "string"
        }
      },
      "required": [
        "owner",
        "ticket",
        "entered",
        "reason"
      ],
      "type": "object"
    }
  },
  "$id": "sentinel:schemas/quarantine.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "records": {
      "items": {
        "$ref": "#/$defs/quarantine_record"
      },
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "records"
  ],
  "title": "quarantine (quarantine_file)",
  "type": "object"
}
