{
  "$defs": {
    "edge": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "type": "number"
        },
        "confirmed_build": {
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
          "type": "string"
        },
        "confirmed_from_source": {
          "default": false,
          "type": "boolean"
        },
        "evidence": {
          "type": "string"
        },
        "first_seen": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
          "type": "string"
        },
        "last_verified": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
          "type": "string"
        },
        "primitive": {
          "pattern": "^[A-Z][A-Za-z0-9]*$",
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "source": {
          "enum": [
            "declared",
            "static_analysis"
          ]
        },
        "surface": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
              "type": "string"
            },
            {
              "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*\\.\\*$",
              "type": "string"
            },
            {
              "const": "*"
            }
          ]
        }
      },
      "required": [
        "primitive",
        "surface",
        "source",
        "confidence",
        "first_seen",
        "last_verified"
      ],
      "type": "object"
    },
    "primitive": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "global": {
          "default": false,
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "source_packages": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "description",
        "source_packages",
        "owner"
      ],
      "type": "object"
    }
  },
  "$id": "sentinel:schemas/dependency-map.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "edges": {
      "items": {
        "$ref": "#/$defs/edge"
      },
      "type": "array"
    },
    "first_scan_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "type": "string"
    },
    "primitives": {
      "items": {
        "$ref": "#/$defs/primitive"
      },
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "primitives",
    "edges"
  ],
  "title": "dependency-map (dependency_map)",
  "type": "object"
}
