            "type_fixture",
            "press",
            "drag",
            "wheel",
            "rclick",
            "dblclick",
            "key_chord",
            "reset_input_state",
            "secret",
            "wait_for",
            "park_mouse",
            "focus_neutral",
            "export",
            "checkpoint",
            "assert",
            "precondition",
            "teardown"
          ]
        }
      },
      "required": [
        "id",
        "type"
      ],
      "type": "object",
      "unevaluatedProperties": false
    }
  },
  "$id": "sentinel:schemas/flow.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "account_role": {
      "default": "empty",
      "enum": [
        "golden",
        "empty"
      ]
    },
    "agent_fallback": {
      "enum": [
        "allowed",
        "disabled"
      ]
    },
    "budget": {
