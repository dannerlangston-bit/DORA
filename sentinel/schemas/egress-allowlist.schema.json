{
  "$id": "sentinel:schemas/egress-allowlist.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "hosts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "host": {
            "type": "string"
          },
          "port": {
            "default": 443,
            "type": "integer"
          },
          "purposes": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "host",
          "purposes"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "signature": {
      "type": "string"
    },
    "signed_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
      "type": "string"
    },
    "signed_by": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "hosts",
    "signed_by",
    "signed_at",
    "signature"
  ],
  "title": "egress-allowlist (egress_allowlist)",
  "type": "object"
}
