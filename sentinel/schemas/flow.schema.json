{
  "$defs": {
    "assertion": {
      "additionalProperties": false,
      "properties": {
        "api_field": {
          "type": "string"
        },
        "expected": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ]
        },
        "export_column": {
          "type": "string"
        },
        "format": {
          "enum": [
            "money",
            "price",
            "int",
            "percent",
            "time",
            "text"
          ]
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": {
            "anyOf": [
              {
                "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
                "type": "string"
              },
              {
                "type": "number"
              }
            ]
          },
          "type": "object"
        },
        "kind": {
          "enum": [
            "equals",
            "matches",
            "within_tol",
            "present",
            "absent",
            "changed_since_previous_step",
            "unchanged_since_previous_step",
            "count",
            "export_equals",
            "api_within",
            "rule",
            "sign_color_agrees"
          ]
        },
        "pattern": {
          "type": "string"
        },
        "range": {
          "additionalProperties": false,
          "properties": {
            "max": {
              "type": "number"
            },
            "min": {
              "type": "number"
            }
          },
          "required": [
            "min",
            "max"
          ],
          "type": "object"
        },
        "region": {
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
          "type": "string"
        },
        "rule_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "type": "string"
        },
        "since_step": {
          "pattern": "^[a-z][a-z0-9_-]*$",
          "type": "string"
        },
        "source": {
          "default": "ocr",
          "enum": [
            "ocr",
            "export",
            "jab",
            "api"
          ]
        },
        "tol": {
          "type": "number"
        },
        "value_ref": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "type": "object"
    },
    "step": {
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "click_named"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "button": {
                "default": "left",
                "enum": [
                  "left",
                  "right",
                  "middle"
                ]
              },
              "target": {
                "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
                "type": "string"
              }
            },
            "required": [
              "target"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "type_fixture"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "oneOf": [
              {
                "required": [
                  "value_ref"
                ]
              },
              {
                "required": [
                  "value"
                ]
              }
            ],
            "properties": {
              "commit": {
                "enum": [
                  "enter",
                  "tab",
                  "none"
                ]
              },
              "target": {
                "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
                "type": "string"
              },
              "value": {
                "type": "string"
              },
              "value_ref": {
                "type": "string"
              },
              "verify": {
                "$ref": "#/$defs/assertion"
              }
            },
            "required": [
              "target",
              "commit"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "press"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "key": {
                "type": "string"
              }
            },
            "required": [
              "key"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "drag"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "from": {
                "anyOf": [
                  {
                    "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
                    "type": "string"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "x": {
                        "type": "integer"
                      },
                      "y": {
                        "type": "integer"
                      }
                    },
                    "required": [
                      "x",
                      "y"
                    ],
                    "type": "object"
                  }
                ]
              },
              "hold_ms": {
                "type": "integer"
              },
              "steps": {
                "type": "integer"
              },
              "to": {
                "anyOf": [
                  {
                    "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
                    "type": "string"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "x": {
                        "type": "integer"
                      },
                      "y": {
                        "type": "integer"
                      }
                    },
                    "required": [
                      "x",
                      "y"
                    ],
                    "type": "object"
                  }
                ]
              }
            },
            "required": [
              "from",
              "to",
              "steps",
              "hold_ms"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "wheel"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "at": {
                "anyOf": [
                  {
                    "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
                    "type": "string"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "x": {
                        "type": "integer"
                      },
                      "y": {
                        "type": "integer"
                      }
                    },
                    "required": [
                      "x",
                      "y"
                    ],
                    "type": "object"
                  }
                ]
              },
              "notches": {
                "type": "integer"
              }
            },
            "required": [
              "at",
              "notches"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "rclick"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "target": {
                "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
                "type": "string"
              }
            },
            "required": [
              "target"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "dblclick"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "target": {
                "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
                "type": "string"
              }
            },
            "required": [
              "target"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "key_chord"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "keys": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "keys"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "reset_input_state"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {}
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "secret"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "commit": {
                "enum": [
                  "enter",
                  "tab",
                  "none"
                ]
              },
              "target": {
                "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
                "type": "string"
              },
              "vault_ref": {
                "type": "string"
              }
            },
            "required": [
              "target",
              "vault_ref",
              "commit"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "wait_for"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "anchor": {
                "additionalProperties": false,
                "properties": {
                  "landmark": {
                    "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
                    "type": "string"
                  },
                  "window_title_regex": {
                    "type": "string"
