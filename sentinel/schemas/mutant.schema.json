{
  "$defs": {
    "mutant": {
      "additionalProperties": false,
      "properties": {
        "canary_flow": {
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
          "type": "string"
        },
        "checkpoint_id": {
          "anyOf": [
            {
              "pattern": "^(?:census/[a-z0-9]+(?:[.-][a-z0-9]+)*/[a-z0-9]+(?:[.-][a-z0-9]+)*(?:/[a-z]+=[A-Za-z0-9.-]+(?:,[a-z]+=[A-Za-z0-9.-]+)*)?|sweep/[a-z0-9]+(?:[.-][a-z0-9]+)*/(?:flexgrid|detached|dialog)/[0-9]+x[0-9]+(?:-asc)?|split/[a-z0-9]+(?:[.-][a-z0-9]+)*/[a-z0-9]+(?:[.-][a-z0-9]+)*/(?:0|1)\\.[0-9]{2}|flow/[a-z0-9]+(?:[.-][a-z0-9]+)*/[a-z0-9]+(?:[.-][a-z0-9]+)*/[a-z][a-z0-9-]*)$",
              "type": "string"
            },
            {
              "const": "*"
            }
          ]
        },
        "class": {
          "enum": [
            "erased_control",
            "swapped_digit",
            "swapped_label",
            "color_swap",
            "shifted_panel",
            "clipped_label",
            "overlapped_panels",
            "missing_row",
            "header_change",
            "placeholder",
            "font_height",
            "scrollbar",
            "redaction",
            "sub_floor",
            "global_shift",
            "landmark_loss",
            "study_removed",
            "aa_control",
            "wrong_quantity",
            "blank_field",
            "gateway",
            "outside_parent",
            "window_offscreen",
            "misaligned_column",
            "focus_order",
            "error_dialog"
          ]
        },
        "expected": {
          "additionalProperties": false,
          "properties": {
            "assertion_id": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
              "type": "string"
            },
            "invariant_id": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
              "type": "string"
            },
            "min_confidence": {
              "type": "number"
            },
            "outcomes": {
              "items": {
                "enum": [
                  "identical",
                  "noise",
                  "intended",
                  "collateral",
                  "needs_human",
                  "invariant_violation",
                  "assertion_failed",
                  "not_settled",
                  "not_comparable",
                  "landmark_missing",
                  "env_error",
                  "harness_error",
                  "not_run",
                  "unregistered_surface",
                  "needs_baseline"
                ]
              },
              "type": "array"
            },
            "reason": {
              "type": "string"
            },
            "redaction_hit": {
              "type": "boolean"
            },
            "step_status": {
              "enum": [
                "passed",
                "passed_after_retry",
                "passed_via_agent_fallback",
                "failed",
                "blocked_by_gateway"
              ]
            }
          },
          "required": [
            "outcomes"
          ],
          "type": "object"
        },
        "generator": {
          "additionalProperties": false,
          "properties": {
            "op": {
              "enum": [
                "erase",
                "translate",
                "replace_glyph",
                "channel_swap",
                "crop_right",
                "overlay",
                "remove_row",
                "type_value"
              ]
            },
            "params": {
              "additionalProperties": {},
              "type": "object"
            },
            "seed": {
              "default": 20260101,
              "type": "integer"
            }
          },
          "required": [
            "op",
            "params"
          ],
          "type": "object"
        },
        "mode": {
          "enum": [
            "image",
            "behavioral"
          ]
        },
        "money_cell": {
          "type": "boolean"
        },
        "mutant_id": {
          "type": "string"
        },
        "name": {
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "region_ref": {
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
          "type": "string"
        }
      },
      "required": [
        "mutant_id",
        "name",
        "checkpoint_id",
        "class",
        "mode",
        "money_cell",
        "generator",
        "expected",
        "owner"
      ],
      "type": "object"
    }
  },
  "$id": "sentinel:schemas/mutant.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "entries": {
      "items": {
        "$ref": "#/$defs/mutant"
      },
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "entries"
  ],
  "title": "mutant (mutant_catalog)",
  "type": "object"
}
