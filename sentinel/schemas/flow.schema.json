                },
                "type": "object"
              },
              "anti_anchors": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "timeout_ms": {
                "type": "integer"
              }
            },
            "required": [
              "anchor",
              "timeout_ms"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "park_mouse"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {}
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "focus_neutral"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "target": {
                "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "export"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "headers": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "kind": {
                "enum": [
                  "file",
                  "copy_all"
                ]
              },
              "path": {
                "pattern": "^(?![/\\\\])(?!.*\\.\\.)[^\\\\]+$",
                "type": "string"
              },
              "target": {
                "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
                "type": "string"
              }
            },
            "required": [
              "target",
              "kind",
              "headers"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "checkpoint"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "account_state": {
                "type": "boolean"
              },
              "checkpoint_id": {
                "pattern": "^(?:census/[a-z0-9]+(?:[.-][a-z0-9]+)*/[a-z0-9]+(?:[.-][a-z0-9]+)*(?:/[a-z]+=[A-Za-z0-9.-]+(?:,[a-z]+=[A-Za-z0-9.-]+)*)?|sweep/[a-z0-9]+(?:[.-][a-z0-9]+)*/(?:flexgrid|detached|dialog)/[0-9]+x[0-9]+(?:-asc)?|split/[a-z0-9]+(?:[.-][a-z0-9]+)*/[a-z0-9]+(?:[.-][a-z0-9]+)*/(?:0|1)\\.[0-9]{2}|flow/[a-z0-9]+(?:[.-][a-z0-9]+)*/[a-z0-9]+(?:[.-][a-z0-9]+)*/[a-z][a-z0-9-]*)$",
                "type": "string"
              },
              "data_mode": {
                "enum": [
                  "frozen",
                  "masked_live"
                ]
              },
              "expect": {
                "items": {
                  "$ref": "#/$defs/assertion"
                },
                "type": "array"
              },
              "keep_focus": {
                "default": false,
                "type": "boolean"
              },
              "max_settle_ms": {
                "type": "integer"
              },
              "recapturable": {
                "default": true,
                "type": "boolean"
              },
              "regions": {
                "anyOf": [
                  {
                    "pattern": "^(?![/\\\\])(?!.*\\.\\.)[^\\\\]+$",
                    "type": "string"
                  },
                  {
                    "const": "default"
                  }
                ]
              },
              "required_labels": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "requires_window": {
                "enum": [
                  "none",
                  "all_quiet",
                  "equities_quiet",
                  "futures_break"
                ]
              },
              "surface_id": {
                "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
                "type": "string"
              },
              "target_window": {
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "enum": [
                      "main",
                      "dialog",
                      "detached",
                      "popup"
                    ]
                  },
                  "title_regex": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind"
                ],
                "type": "object"
              },
              "tier": {
                "enum": [
                  1,
                  2,
                  3
                ]
              }
            },
            "required": [
              "checkpoint_id",
              "surface_id",
              "target_window",
              "data_mode",
              "regions"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "assert"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "assertions": {
                "items": {
                  "$ref": "#/$defs/assertion"
                },
                "type": "array"
              }
            },
            "required": [
              "assertions"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "precondition"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "check": {
                "enum": [
                  "paper_mode",
                  "workspace_loaded",
                  "no_modal",
                  "single_main_frame",
                  "main_window_rect",
                  "fixture_symbol_linked",
                  "working_orders",
                  "settings_attested",
                  "app_alive"
                ]
              },
              "expect": {}
            },
            "required": [
              "check"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "teardown"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "action": {
                "enum": [
                  "close_dialog",
                  "clear_ticket",
                  "close_non_main_windows",
                  "reset_ui",
                  "reload_workspace",
                  "reset_profile",
                  "cancel_all",
                  "working_orders_check",
                  "positions_flat_check"
                ]
              },
              "expect": {},
              "target": {
                "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
                "type": "string"
              }
            },
            "required": [
              "action"
            ]
          }
        }
      ],
      "properties": {
