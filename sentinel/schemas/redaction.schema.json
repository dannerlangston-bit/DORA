{
  "$defs": {
    "region": {
      "additionalProperties": false,
      "properties": {
        "fixture_dependency": {
          "type": "string"
        },
        "floor_exception": {
          "additionalProperties": false,
          "properties": {
            "approved_at": {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
              "type": "string"
            },
            "approved_by": {
              "type": "string"
            },
            "edge_tolerance_px": {
              "default": 1,
              "type": "integer"
            },
            "expires_at": {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
              "type": "string"
            },
            "measured_floor": {
              "type": "number"
            },
            "owner": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            },
            "ticket": {
              "type": "string"
            }
          },
          "required": [
            "approved_by",
            "approved_at",
            "owner",
            "reason",
            "ticket",
            "measured_floor",
            "expires_at"
          ],
          "type": "object"
        },
        "id": {
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
          "type": "string"
        },
        "identity_field": {
          "default": false,
          "type": "boolean"
        },
        "landmark": {
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
          "type": "string"
        },
        "mask_ref": {
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
          "type": "string"
        },
        "money_cell": {
          "default": false,
          "type": "boolean"
        },
        "money_role": {
          "enum": [
            "qty",
            "price",
            "bp_effect",
            "max_loss",
            "send",
            "cancel",
            "delete"
          ]
        },
        "panel": {
          "default": "other",
          "enum": [
            "order_confirmation",
            "order_ticket",
            "position_statement",
            "account_info",
            "other"
          ]
        },
        "rect": {
          "additionalProperties": false,
          "properties": {
            "dx": {
              "type": "integer"
            },
            "dy": {
              "type": "integer"
            },
            "h": {
              "type": "integer"
            },
            "w": {
              "type": "integer"
            }
          },
          "required": [
            "dx",
            "dy",
            "w",
            "h"
          ],
          "type": "object"
        },
        "rule": {
          "$ref": "#/$defs/rule"
        },
        "type": {
          "enum": [
            "freeze",
            "rule",
            "mask",
            "diff",
            "redaction"
          ]
        }
      },
      "required": [
        "id",
        "type",
        "landmark",
        "rect"
      ],
      "type": "object"
    },
    "rule": {
      "additionalProperties": false,
      "properties": {
        "api_window": {
          "additionalProperties": false,
          "properties": {
            "delay_s": {
              "default": 1200,
              "type": "integer"
            },
            "field": {
              "type": "string"
            },
            "tol_ticks": {
              "default": 1,
              "type": "integer"
            }
          },
          "required": [
            "field"
          ],
          "type": "object"
        },
        "decimals": {
          "type": "integer"
        },
        "field": {
          "enum": [
            "price",
            "int",
            "money",
            "time",
            "text",
            "percent"
          ]
        },
        "max": {
          "type": "number"
        },
        "min": {
          "type": "number"
        },
        "min_rows": {
          "type": "integer"
        },
        "must_advance": {
          "type": "boolean"
        },
        "must_change_within_s": {
          "type": "integer"
        },
        "must_not_change_when_closed": {
          "type": "boolean"
        },
        "pattern": {
          "type": "string"
        }
      },
      "required": [
        "field"
      ],
      "type": "object"
    }
  },
  "$id": "sentinel:schemas/redaction.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "landmarks": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "confidence_min": {
            "default": 0.92,
            "type": "number"
          },
          "id": {
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
            "type": "string"
          },
          "search_rect": {
            "additionalProperties": false,
            "properties": {
              "h": {
                "type": "integer"
              },
              "w": {
                "type": "integer"
              },
              "x": {
                "type": "integer"
              },
              "y": {
                "type": "integer"
              }
            },
            "required": [
              "x",
              "y",
              "w",
              "h"
            ],
            "type": "object"
          },
          "template": {
            "pattern": "^(?![/\\\\])(?!.*\\.\\.)[^\\\\]+$",
            "type": "string"
          }
        },
        "required": [
          "id",
          "template"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "owner": {
      "type": "string"
    },
    "regions": {
      "items": {
        "$ref": "#/$defs/region"
      },
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "owner",
    "landmarks",
    "regions"
  ],
  "title": "redaction (redaction_file)",
  "type": "object"
}
