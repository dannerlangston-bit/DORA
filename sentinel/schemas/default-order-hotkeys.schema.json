{
  "$id": "sentinel:schemas/default-order-hotkeys.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "build": {
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "type": "string"
    },
    "chords": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "type": "string"
          },
          "chord": {
            "type": "string"
          }
        },
        "required": [
          "chord",
          "action"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "read_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
      "type": "string"
    },
    "read_by": {
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "verified": {
      "default": false,
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "build",
    "chords"
  ],
  "title": "default-order-hotkeys (default_order_hotkeys)",
  "type": "object"
}
