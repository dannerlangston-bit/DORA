{
  "$id": "sentinel:schemas/dismiss-allowlist.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "labels": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "read_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
      "type": "string"
    },
    "read_by": {
      "type": "string"
    },
    "read_on_build": {
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "labels"
  ],
  "title": "dismiss-allowlist (dismiss_allowlist)",
  "type": "object"
}
