{
  "$id": "sentinel:schemas/credential-rotation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "logins": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "backup_owner": {
            "type": "string"
          },
          "login_ref": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "sms_device": {
            "type": "string"
          }
        },
        "required": [
          "login_ref",
          "owner",
          "backup_owner"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "rotations": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "password",
              "vault_token"
            ]
          },
          "login_ref": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "validating_run_id": {
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
            "type": "string"
          },
          "window": {
            "additionalProperties": false,
            "properties": {
              "end": {
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
                "type": "string"
              },
              "start": {
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
                "type": "string"
              }
            },
            "required": [
              "start",
              "end"
            ],
            "type": "object"
          }
        },
        "required": [
          "login_ref",
          "kind",
          "window",
          "owner"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "logins",
    "rotations"
  ],
  "title": "credential-rotation (credential_rotation)",
  "type": "object"
}
